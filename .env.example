# Copy to .env and adjust. NEVER commit .env.
# The app runs in Docker; docker-compose.yml sets these for the web service.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to issue CSRF-protected POSTs in production (DEBUG=False).
# Comma-separated, WITH scheme. A `https://*.example.com` entry is a subdomain
# wildcard (apex + all subdomains). The default already trusts terminschleuder.online
# (apex, www, and *.terminschleuder.online), so you only need to set this for a
# different/staging domain:
# CSRF_TRUSTED_ORIGINS=https://*.terminschleuder.online

# CORS — read-only access for the demo SPA (a browser on another origin). Default
# allows ALL origins for GET/HEAD/OPTIONS with no credentials (the public catalog).
# For production, set CORS_ALLOW_ALL_ORIGINS=False and list the allowed origins:
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://demo.terminschleuder.online,https://terminschleuder.online

# PostGIS database. In compose the host is `db`; on the host use 127.0.0.1.
DATABASE_URL=postgis://terminschleuder:terminschleuder@127.0.0.1:5432/terminschleuder

# Optional: separate JWT signing key for production (defaults to SECRET_KEY).
# DJANGO_JWT_SIGNING_KEY=some-long-random-string

# First-boot bootstrap (entrypoint runs `manage.py bootstrap` on every start;
# idempotent — an existing superuser is NEVER overwritten, so rotate the
# password via /admin/ instead of changing this value later). Unset the
# username to skip superuser creation entirely (group + cities still load):
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=change-me-on-first-login
# DJANGO_SUPERUSER_EMAIL=admin@example.com

# Serve /media/ (hero images) through Django. Default on — the pure-container
# deployment has no reverse proxy. Set False when a proxy/CDN serves /media/:
# SERVE_MEDIA=True

# Set to 1 for one-off jobs (`docker run --rm <image> python manage.py shell`)
# so the entrypoint skips migrate + bootstrap and doesn't touch the DB:
# ENTRYPOINT_SKIP_TASKS=0
# Copy to .env and adjust. NEVER commit .env.
# The app runs in Docker; docker-compose.yml sets these for the web service.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostGIS database. In compose the host is `db`; on the host use 127.0.0.1.
DATABASE_URL=postgis://terminschleuder:terminschleuder@127.0.0.1:5432/terminschleuder

# Optional: separate JWT signing key for production (defaults to SECRET_KEY).
# DJANGO_JWT_SIGNING_KEY=some-long-random-string